# --- Base de datos ---
# Desarrollo local: las dos URLs apuntan a la misma base.
# Supabase: DATABASE_URL = pooler en modo transacción (puerto 6543, con ?pgbouncer=true&connection_limit=1)
#           DIRECT_URL   = conexión directa o pooler en modo sesión (puerto 5432), la usan las migraciones.
DATABASE_URL="postgresql://tcshop:tcshop@localhost:5432/tcshop?schema=public"
DIRECT_URL="postgresql://tcshop:tcshop@localhost:5432/tcshop?schema=public"

# --- Servidor ---
NODE_ENV=development
PORT=3001

# --- Sesión ---
# Secreto para firmar los JWT, mínimo 32 caracteres. Generarlo con: openssl rand -base64 48
JWT_SECRET=
# Duración de la sesión: s, m, h o d (por ejemplo 7d, 12h).
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (URL del front), separados por coma.
CORS_ORIGIN=http://localhost:3000

# Swagger se sirve en /docs. En producción está apagado salvo que pongas true.
SWAGGER_ENABLED=false

# --- Usuario admin inicial (solo lo usa el seed) ---
ADMIN_EMAIL=
# Mínimo 12 caracteres.
ADMIN_PASSWORD=
ADMIN_NOMBRE=
