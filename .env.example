# Variables para docker compose. Para correr sin Docker, usar apps/api/.env y apps/web/.env.local.

# Secreto para firmar los JWT, mínimo 32 caracteres: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Usuario admin que crea el seed (contraseña de al menos 12 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=
